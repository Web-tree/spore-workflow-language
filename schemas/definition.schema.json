{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Web-tree/spore-workflow-language/blob/main/schemas/definition.schema.json",
  "title": "SWL draft normalized workflow definition",
  "description": "Structural validation only. Cross-reference, graph and capability checks are normative in spec/definition.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "name",
    "start",
    "nodes"
  ],
  "properties": {
    "language": {
      "const": "swl"
    },
    "name": {
      "$ref": "#/$defs/id"
    },
    "start": {
      "$ref": "#/$defs/id"
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxVisitsPerNode": {
          "type": "integer",
          "minimum": 1
        },
        "maxActivations": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inputSchema": {
      "type": "object"
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
    },
    "outcome": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "mapping": {},
    "route": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/outcome"
      },
      "additionalProperties": {
        "$ref": "#/$defs/id"
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "outcomes"
      ],
      "properties": {
        "effect": {
          "enum": [
            "pure",
            "read-only",
            "idempotent",
            "unsafe"
          ]
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchemas": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "routes"
          ],
          "properties": {
            "kind": {
              "const": "activity"
            },
            "action": {
              "$ref": "#/$defs/id"
            },
            "routes": {
              "$ref": "#/$defs/route"
            },
            "input": {
              "$ref": "#/$defs/mapping"
            },
            "params": {
              "$ref": "#/$defs/mapping"
            },
            "loopLimits": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "signal",
            "routes"
          ],
          "properties": {
            "kind": {
              "const": "await-signal"
            },
            "signal": {
              "type": "string",
              "minLength": 1
            },
            "routes": {
              "$ref": "#/$defs/route"
            },
            "loopLimits": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "complete"
            },
            "output": {
              "$ref": "#/$defs/mapping"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "error"
          ],
          "properties": {
            "kind": {
              "const": "fail"
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    }
  }
}
