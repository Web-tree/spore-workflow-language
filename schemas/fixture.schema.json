{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Web-tree/spore-workflow-language/blob/main/schemas/fixture.schema.json",
  "title": "SWL conformance fixture",
  "description": "Structure of one fixture file. Semantics are normative in spec/fixtures.md.",
  "type": "object",
  "required": ["fixture", "title", "spec", "profiles"],
  "properties": {
    "fixture": { "enum": ["definition", "dot", "trace"] },
    "title": { "type": "string", "minLength": 1 },
    "spec": { "type": "string", "minLength": 1 },
    "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "oneOf": [
    {
      "properties": {
        "fixture": { "const": "definition" },
        "definition": { "type": "object" },
        "supported": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "expect": {
          "oneOf": [
            { "type": "object", "required": ["valid"], "properties": { "valid": { "const": true } }, "additionalProperties": false },
            { "type": "object", "required": ["errors"], "properties": { "errors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/code" } } }, "additionalProperties": false }
          ]
        }
      },
      "required": ["definition", "expect"]
    },
    {
      "properties": {
        "fixture": { "const": "dot" },
        "source": { "type": "string" },
        "settings": { "type": "object" },
        "expect": {
          "oneOf": [
            { "type": "object", "required": ["definition"], "properties": { "definition": { "type": "object" } }, "additionalProperties": false },
            { "type": "object", "required": ["rejected"], "properties": { "rejected": { "const": true } }, "additionalProperties": false }
          ]
        }
      },
      "required": ["source", "expect"]
    },
    {
      "properties": {
        "fixture": { "const": "trace" },
        "definition": { "type": "object" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["event", "expect"],
            "additionalProperties": false,
            "properties": {
              "event": { "$ref": "#/$defs/event" },
              "expect": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": { "enum": ["running", "waiting", "needs-intervention", "completed", "failed", "cancelled"] },
                  "positions": { "type": "array", "items": { "type": "string" } },
                  "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
                  "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/code" } },
                  "nodes": { "type": "object" },
                  "result": {},
                  "error": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
                }
              }
            }
          }
        }
      },
      "required": ["definition", "steps"]
    }
  ],
  "$defs": {
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$" },
    "reference": {
      "type": "object",
      "required": ["node", "visit"],
      "additionalProperties": false,
      "properties": { "node": { "type": "string" }, "visit": { "type": "integer", "minimum": 1 } }
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "runId"],
          "additionalProperties": false,
          "properties": { "type": { "const": "start" }, "runId": { "type": "string", "minLength": 1 }, "input": {} }
        },
        {
          "type": "object",
          "required": ["type", "invocation", "status"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "result" },
            "invocation": { "$ref": "#/$defs/reference" },
            "status": { "enum": ["success", "failure", "unknown"] },
            "outcome": { "type": "string" },
            "output": {},
            "error": { "type": "string" },
            "retryable": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["type", "name", "outcome"],
          "additionalProperties": false,
          "properties": { "type": { "const": "signal" }, "name": { "type": "string" }, "outcome": { "type": "string" }, "output": {} }
        },
        {
          "type": "object",
          "required": ["type", "invocation", "action"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "resolve" },
            "invocation": { "$ref": "#/$defs/reference" },
            "action": { "enum": ["complete", "retry", "fail"] },
            "outcome": { "type": "string" },
            "output": {},
            "error": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "const": "cancel" }, "reason": { "type": "string" } }
        }
      ]
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "node", "visit", "attempt", "action", "input", "params"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "invoke" },
            "node": { "type": "string" },
            "visit": { "type": "integer", "minimum": 1 },
            "attempt": { "type": "integer", "minimum": 1 },
            "action": { "type": "string" },
            "input": {},
            "params": {}
          }
        },
        {
          "type": "object",
          "required": ["type", "invocation"],
          "additionalProperties": false,
          "properties": { "type": { "const": "cancel" }, "invocation": { "$ref": "#/$defs/reference" } }
        }
      ]
    }
  }
}
